import requests

response = requests.request(
    "POST",
    "http://localhost:8080/upload",
    auth=("alice", "pa'ss"),
    data={
        "title": "Q3 report",
    },
    files={
        "file": ("q3.pdf", open("docs/report.pdf", "rb"), "application/pdf"),
    },
)
print(response.status_code)
print(response.text)
