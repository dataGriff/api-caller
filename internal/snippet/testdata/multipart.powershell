$headers = @{
  'Authorization' = 'Basic ' + [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes('alice' + ':' + 'pa''ss'))
}
$form = @{
  'title' = 'Q3 report'
  'file' = Get-Item 'docs/report.pdf'
}
Invoke-RestMethod -Method Post `
  -Uri 'http://localhost:8080/upload' `
  -Headers $headers `
  -Form $form
