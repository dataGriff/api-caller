import os

import requests

response = requests.request(
    "GET",
    "https://internal.example.com/v1/items",
    params={"api_key": os.environ["APIC_API_KEY"]},
    verify=False,
    proxies={"http": "http://proxy.internal:3128", "https": "http://proxy.internal:3128"},
)
print(response.status_code)
print(response.text)
