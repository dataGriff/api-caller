{{define "head"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · {{if .Failed}}{{.Failed}} failed{{else}}all passed{{end}}</title>
<style>
:root{--bg:#ffffff;--fg:#1f2430;--dim:#6b7280;--line:#e5e7eb;--panel:#f6f7f9;--ok:#008b57;--warn:#b86e00;--fail:#d13c3c;--url:#0077cc;--header:#7a4fd6;--capture:#0a8fb5;--accent:#c4297f;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
@media (prefers-color-scheme:dark){:root{--bg:#14161c;--fg:#e6e8ee;--dim:#9aa1ad;--line:#2a2f3a;--panel:#1c2029;--ok:#00d787;--warn:#ffaf00;--fail:#ff5f5f;--url:#00afff;--header:#af87ff;--capture:#5fd7ff;--accent:#ff87d7}}
*{box-sizing:border-box}
body{margin:0;padding:24px 16px 48px;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;max-width:1100px;margin-inline:auto}
h1{font-size:22px;margin:0 0 4px}
h2{font-size:17px;margin:32px 0 8px}
.meta{color:var(--dim);font-size:13px;display:flex;flex-wrap:wrap;gap:6px 16px;margin:0 0 20px}
.badge{display:inline-block;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid var(--line)}
.badge.ok{color:var(--ok);border-color:var(--ok)}
.badge.fail{color:var(--fail);border-color:var(--fail)}
.badge.warn{color:var(--warn);border-color:var(--warn)}
.badge.redacted{color:var(--accent);border-color:var(--accent)}
.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:0 0 24px}
.summary div{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.summary b{display:block;font-size:22px}
.summary span{color:var(--dim);font-size:12px}
.summary .ok b{color:var(--ok)}
.summary .fail b{color:var(--fail)}
details{border:1px solid var(--line);border-radius:8px;margin:0 0 10px;background:var(--bg)}
details>summary{cursor:pointer;padding:10px 12px;list-style:none;display:flex;flex-wrap:wrap;gap:6px 12px;align-items:baseline}
details>summary::-webkit-details-marker{display:none}
details>summary::before{content:"▸";color:var(--dim);margin-right:2px}
details[open]>summary::before{content:"▾"}
details>.body{padding:0 12px 12px}
details.inner{margin:8px 0 0;background:var(--panel)}
.method{font-family:var(--mono);font-weight:700}
.url{font-family:var(--mono);color:var(--url);word-break:break-all}
.file{color:var(--dim);font-size:13px}
.status{font-weight:600}
.status.ok{color:var(--ok)}
.status.warn{color:var(--warn)}
.status.fail{color:var(--fail)}
.dim{color:var(--dim)}
pre{margin:0;padding:10px 12px;background:var(--panel);border-radius:6px;overflow:auto;font:13px/1.45 var(--mono);white-space:pre-wrap;word-break:break-word}
table{border-collapse:collapse;font-size:13px}
td,th{text-align:left;padding:3px 8px 3px 0;vertical-align:top;font-family:var(--mono)}
th{color:var(--header);font-weight:600;white-space:nowrap}
ul.checks{list-style:none;padding:0;margin:8px 0 0}
ul.checks li{padding:2px 0;font-family:var(--mono);font-size:13px}
.pass::before{content:"✓ ";color:var(--ok)}
.failed::before{content:"✗ ";color:var(--fail)}
.capture::before{content:"↳ ";color:var(--capture)}
.step{padding:3px 0;font-family:var(--mono);font-size:13px}
.step.passed::before{content:"✓ ";color:var(--ok)}
.step.failed::before,.step.undefined::before,.step.ambiguous::before,.step.pending::before{content:"✗ ";color:var(--fail)}
.step.skipped::before{content:"– ";color:var(--dim)}
.step .kw{color:var(--header)}
.error{color:var(--fail);white-space:pre-wrap;font-family:var(--mono);font-size:13px;margin:4px 0 8px 22px}
.timings{color:var(--dim);font-size:12px;margin:6px 0 0}
footer{margin-top:40px;color:var(--dim);font-size:12px}
</style>
</head>
<body>
<h1>{{.Title}}</h1>
<p class="meta"><span>{{.Time.Format "2006-01-02 15:04:05 UTC"}}</span>{{if .Env}}<span>environment <b>{{.Env}}</b></span>{{end}}{{if .Project}}<span>{{.Project}}</span>{{end}}<span>apic {{.Version}}</span>{{if .Redacted}}<span class="badge redacted">redacted</span>{{end}}</p>
{{end}}

{{define "foot"}}<footer>Generated by <a href="https://datagriff.github.io/api-caller/">apic</a> {{.Version}}. One file, no external assets; open it anywhere.</footer>
</body>
</html>
{{end}}

{{define "request"}}<details{{if not .OK}} open{{end}}>
<summary>{{if .Skipped}}<span class="badge warn">skipped</span>{{else}}<span class="badge {{if .OK}}ok{{else}}fail{{end}}">{{if .OK}}pass{{else}}fail{{end}}</span>{{end}} <span class="method">{{.Method}}</span> <span class="url">{{.URL}}</span> <span class="file">{{.Name}} · {{.File}}:{{.Line}}</span>{{if .Status}} <span class="status {{if lt .Status 300}}ok{{else if lt .Status 400}}warn{{else}}fail{{end}}">{{.Status}} {{.StatusText}}</span> <span class="dim">{{ms .Duration}} · {{.Size}} B{{if gt .Attempts 1}} · {{.Attempts}} attempts{{end}}{{if .Auth}} · auth {{.Auth}}{{end}}</span>{{end}}</summary>
<div class="body">
{{if .Deps}}<div class="dim">ran first (# @ref)</div>{{range .Deps}}{{template "request" .}}{{end}}{{end}}
{{if .Skipped}}<p class="dim">Skipped ({{.Skipped}}): the flow did not send it.</p>{{end}}{{if .Errors}}{{range .Errors}}<div class="error">{{.}}</div>{{end}}{{end}}
{{if or .Asserts .Captures}}<ul class="checks">{{range .Asserts}}<li class="{{if .Pass}}pass{{else}}failed{{end}}">{{.Expr}}{{if .Error}} <span class="dim">({{.Error}})</span>{{else if not .Pass}} <span class="dim">(actual: {{.Actual}}{{if .Expected}}, expected: {{.Expected}}{{end}})</span>{{end}}</li>{{end}}{{range .Captures}}<li class="capture">{{.Key}} = {{.Value}}</li>{{end}}</ul>{{end}}
{{if .Timings}}<div class="timings">dns {{.Timings.DNSMs}} ms · connect {{.Timings.ConnectMs}} ms · tls {{.Timings.TLSMs}} ms · ttfb {{.Timings.TTFBMs}} ms · total {{.Timings.TotalMs}} ms · {{if .Timings.Reused}}reused{{else}}new{{end}} connection</div>{{end}}
<details class="inner"><summary>request</summary><div class="body">{{if .RequestHeaders}}<table>{{range .RequestHeaders}}<tr><th>{{.Key}}</th><td>{{.Value}}</td></tr>{{end}}</table>{{end}}{{if .RequestBody}}<pre>{{json .RequestBody}}</pre>{{else if not .RequestHeaders}}<span class="dim">no headers, no body</span>{{end}}</div></details>
{{if .Status}}<details class="inner"><summary>response</summary><div class="body">{{if .ResponseHeaders}}<table>{{range .ResponseHeaders}}<tr><th>{{.Key}}</th><td>{{.Value}}</td></tr>{{end}}</table>{{end}}{{if .ResponseBody}}<pre>{{json .ResponseBody}}</pre>{{else}}<span class="dim">empty body</span>{{end}}</div></details>{{end}}
</div>
</details>
{{end}}

{{define "run"}}{{template "head" .}}
<div class="summary"><div class="{{if .Failed}}fail{{else}}ok{{end}}"><b>{{if .Failed}}{{.Failed}} failed{{else}}all passed{{end}}</b><span>{{len .Requests}} requests</span></div><div class="ok"><b>{{.Passed}}</b><span>passed</span></div><div class="{{if .Failed}}fail{{end}}"><b>{{.Failed}}</b><span>failed</span></div>{{if .Skipped}}<div><b>{{.Skipped}}</b><span>skipped</span></div>{{end}}<div><b>{{ms .Duration}}</b><span>total response time</span></div></div>
<h2>Requests</h2>
{{range .Requests}}{{template "request" .}}{{end}}
{{template "foot" .}}{{end}}

{{define "features"}}{{template "head" .}}
<div class="summary"><div class="{{if .Failed}}fail{{else}}ok{{end}}"><b>{{if .Failed}}{{.Failed}} failed{{else}}all passed{{end}}</b><span>{{.Scenarios}} scenarios · {{.Steps}} steps</span></div><div class="ok"><b>{{.Passed}}</b><span>passed</span></div><div class="{{if .Failed}}fail{{end}}"><b>{{.Failed}}</b><span>failed</span></div><div><b>{{.Skipped}}</b><span>skipped</span></div>{{if .Undefined}}<div class="fail"><b>{{.Undefined}}</b><span>undefined steps</span></div>{{end}}<div><b>{{ms .Duration}}</b><span>total step time</span></div></div>
{{range .Features}}<h2>{{.Name}} <span class="file">{{.URI}}</span> <span class="badge {{if .Passed}}ok{{else}}fail{{end}}">{{if .Passed}}pass{{else}}fail{{end}}</span></h2>
{{range .Scenarios}}<details{{if ne .Status "passed"}} open{{end}}>
<summary><span class="badge {{if eq .Status "passed"}}ok{{else if eq .Status "skipped"}}warn{{else}}fail{{end}}">{{.Status}}</span> <span>{{.Keyword}}: {{.Name}}</span> <span class="dim">{{ms .Duration}}</span></summary>
<div class="body">{{range .Steps}}<div class="step {{.Status}}"><span class="kw">{{.Keyword}}</span> {{.Name}}{{if .DocString}}<pre>{{json .DocString}}</pre>{{end}}{{if .Rows}}<table>{{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}</table>{{end}}</div>{{if .Error}}<div class="error">{{.Error}}</div>{{end}}{{end}}</div>
</details>
{{end}}{{end}}
{{template "foot" .}}{{end}}
