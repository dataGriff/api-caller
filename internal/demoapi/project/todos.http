@title = Write docs

### List todos
# @name list-todos
# @step I list the todos
# @assert status == 200
# @assert body.$.# >= 1
GET {{baseUrl}}/todos
Authorization: Bearer {{token}}

### Filter and paginate; the total comes back in a header
# @name list-open-todos
# @step I list the open todos
# @assert status == 200
# @assert header.x-total-count >= 1
# @assert body.$.# <= 5
# @assert body.$[0].done == false
GET {{baseUrl}}/todos
    ?done=false
    &page=1
    &limit=5
Authorization: Bearer {{token}}

### Create a todo
# @name create-todo
# @step a todo titled {title} is created
# @assert status == 201
# @assert body.$.title == "{{title}}"
# @capture todoId = body.$.id
# @capture todoTitle = body.$.title
POST {{baseUrl}}/todos
Authorization: Bearer {{token}}
Content-Type: application/json

{"title": "{{title}}"}

### Fetch the todo just created
# @name get-todo
# @step I fetch the todo
# @assert status == 200
# @assert body.$.title == "{{todoTitle}}"
GET {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{token}}

### Mark it done
# @name update-todo
# @step I mark the todo done
# @assert status == 200
# @assert body.$.done == true
PUT {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"done": true}

### Confirm the update stuck
# @name get-updated
# @assert status == 200
# @assert body.$.done == true
GET {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{token}}

### Delete it
# @name delete-todo
# @step I delete the todo
# @assert status == 204
DELETE {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{token}}

### Confirm the delete stuck
# @name get-deleted
# @assert status == 404
GET {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{token}}

### Validation errors come back as 422 with a field map
# @name create-todo-invalid
# @step I create a todo with no title
# @assert status == 422
# @assert body.$.error == "validation failed"
# @assert body.$.fields.title exists
POST {{baseUrl}}/todos
Authorization: Bearer {{token}}
Content-Type: application/json

{"title": ""}

### A request that will fail its assertion
# @name not-found
# @assert status == 200
GET {{baseUrl}}/status/404

### Redirects are followed by default
# @name redirect-followed
# @assert status == 200
GET {{baseUrl}}/redirect

### ...unless you opt out
# @name redirect-raw
# @no-redirect
# @assert status == 302
# @assert header.location contains status/200
GET {{baseUrl}}/redirect
