{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "apic.directives.injection",
  "injectionSelector": "L:source.http, L:text.http",
  "comment": "Highlights apic's `# @directive value` comment lines inside .http files without owning the language: REST Client (or another extension) keeps providing the http grammar, and this is layered on top. The list of known directives in the first pattern mirrors KnownDirectives in internal/httpfile/parse.go; a Go test (TestGrammarMatchesKnownDirectives) fails when they drift.",
  "patterns": [
    {
      "name": "meta.directive.apic",
      "match": "^\\s*((?:#|//)\\s*)(@(?:name|description|capture|assert|auth|step|ref|forceRef|no-redirect|no-session|no-cookies|timeout|retry|note|prompt))\\b(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.apic" },
        "2": { "name": "keyword.control.directive.apic" },
        "3": {
          "name": "string.unquoted.directive.apic",
          "patterns": [
            {
              "name": "variable.other.placeholder.apic",
              "match": "\\{\\{[^}]*\\}\\}"
            },
            {
              "name": "keyword.operator.assertion.apic",
              "match": "\\s(==|!=|<=|>=|<|>|contains|startsWith|endsWith|matchesSchema|matches|not exists|exists|(?:not )?is(?:String|Number|Integer|Boolean|Array|Object|Null|Empty)|length)(?=\\s|$)"
            },
            {
              "name": "support.function.selector.apic",
              "match": "\\b(status|statusText|duration|header\\.[\\w.-]+|body(?:\\.\\$[^\\s]*)?)"
            }
          ]
        }
      }
    },
    {
      "name": "meta.directive.unknown.apic",
      "match": "^\\s*((?:#|//)\\s*)(@[A-Za-z][\\w-]*)\\b(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.apic" },
        "2": { "name": "invalid.deprecated.directive.apic" },
        "3": { "name": "comment.line.apic" }
      }
    }
  ]
}
