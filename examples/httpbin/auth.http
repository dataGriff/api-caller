### Log in and keep the token
# httpbin echoes the JSON we post, so the "token" comes back under json.token.
# @name login
# @assert status == 200
# @capture token = body.$.json.token
POST {{baseUrl}}/post
Content-Type: application/json

{"user": "{{user}}", "password": "{{password}}", "token": "demo-{{$uuid}}"}

### Call an endpoint that needs the token
# @name whoami
# @description Uses the token captured by login
# @assert status == 200
# @assert body.$.authenticated == true
GET {{baseUrl}}/bearer
Authorization: Bearer {{token}}
